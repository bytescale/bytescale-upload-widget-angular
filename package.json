{
  "name": "@bytescale/upload-widget-angular-workspace",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build bytescale-upload-widget-angular",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "rm -rf projects/bytescale-upload-widget-angular/node_modules && ng test --watch=false --browsers ChromeHeadless",
    "test:e2e": "wdio run ./wdio.conf.ts",
    "prepare": "husky install"
  },
  "private": true,
  "lint-staged": {
    "*/**/*.{js,jsx,ts,tsx,test}": [
      "bash -c \"npm run test:unit\""
    ],
    "*/**/*.{ts,tsx}": [
      "bash -c \"tsc --noEmit\""
    ],
    "*.{js,jsx,ts,tsx,json,css,html,md,yaml,yml}": [
      "prettier -w"
    ]
  },
  "dependencies": {
    "@angular/animations": "21.2.25",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/platform-browser-dynamic": "21.2.25",
    "@angular/router": "21.2.25",
    "@bytescale/upload-widget": "^4.29.0",
    "rxjs": "^7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "^0.16.1"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "21.2.27",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@types/jasmine": "^5.1.0",
    "@wdio/cli": "10.1.0",
    "@wdio/globals": "10.1.0",
    "@wdio/local-runner": "10.1.0",
    "@wdio/mocha-framework": "10.1.0",
    "@wdio/spec-reporter": "10.1.0",
    "husky": "^7.0.4",
    "jasmine-core": "^5.1.0",
    "karma": "^6.4.0",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.0",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "lint-staged": "16.4.0",
    "ng-packagr": "21.2.7",
    "prettier": "2.1.2",
    "typescript": "^5.9.3",
    "webdriverio": "10.1.0",
    "expect-webdriverio": "8.0.0"
  },
  "overrides": {
    "serialize-javascript": "^7.0.5",
    "brace-expansion@1": "1.1.21",
    "brace-expansion@2": "2.1.7"
  }
}
